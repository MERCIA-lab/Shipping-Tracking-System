{
  "name": "imeek-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/admin-portal",
    "dev:admin": "npm run dev --workspace apps/admin-portal",
    "dev:customer": "npm run dev --workspace apps/customer-web",
    "dev:landing": "npm run dev --workspace apps/landing-web",
    "dev:gateway": "npm run dev --workspace apps/api-gateway",
    "dev:product": "npm run dev --workspace services/product-service",
    "dev:auth": "npm run dev --workspace services/auth-service",
    "dev:order": "npm run dev --workspace services/order-service",
    "dev:inventory": "npm run dev --workspace services/inventory-service",
    "dev:payment": "npm run dev --workspace services/payment-service",
    "dev:user": "npm run dev --workspace services/user-service",
    "build": "npm run build --workspaces",
    "build:admin": "npm run build --workspace apps/admin-portal",
    "build:customer": "npm run build --workspace apps/customer-web",
    "build:gateway": "npm run build --workspace apps/api-gateway",
    "build:product": "npm run build --workspace services/product-service",
    "build:auth": "npm run build --workspace services/auth-service",
    "build:order": "npm run build --workspace services/order-service",
    "build:inventory": "npm run build --workspace services/inventory-service",
    "build:payment": "npm run build --workspace services/payment-service",
    "build:user": "npm run build --workspace services/user-service",
    "preview": "npm run preview --workspace apps/admin-portal",
    "lint": "npm run lint --workspaces",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
