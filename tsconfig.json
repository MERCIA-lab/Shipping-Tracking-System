{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@imeek/ui": ["packages/ui/src/index.ts"],
      "@imeek/types": ["packages/types/src/index.ts"],
      "@imeek/utils": ["packages/utils/src/index.ts"]
    }
  },
  "include": ["apps", "packages", "services"]
}
